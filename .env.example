# Optional: without these the app uses its in-memory curated demo data.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-private-server-key

# Optional AI integration. Keep this key server-side; never use NEXT_PUBLIC_.
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
AI_MONTHLY_BUDGET_USD=10
AI_REQUIRE_CRITIC=true

# Optional affiliate tracking.
AFFILIATE_FLIGHTS_MARKER=replace-with-your-marker
AFFILIATE_BOOKING_AID=replace-with-your-aid

# Local development and request limits.
IP_HASH_SALT=replace-with-a-random-private-value
RATE_LIMIT_PER_HOUR=20
# RATE_LIMIT_DISABLED=1
# NEXT_PUBLIC_USE_MOCK=1
# TP_NOW=2026-10-28T12:00:00Z
